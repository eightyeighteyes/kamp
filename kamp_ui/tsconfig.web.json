{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  // KAMP-766: shared *.test.ts run under node --test and import node:test with
  // `.ts` specifiers; they are typechecked by tsconfig.node.json instead.
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    // KAMP-765: shared modules that import a sibling must use a `.ts` specifier,
    // because node --test loads them with native type stripping. Same option as
    // tsconfig.node.json (KAMP-744); Vite resolves the specifier when bundling.
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  }
}
